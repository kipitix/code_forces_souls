{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dlv-headless-stdin",
            "type": "shell",
            "command": "dlv debug --headless --listen=127.0.0.1:2345 --api-version=2 --accept-multiclient -- < test2.txt",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "API server listening at:"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
